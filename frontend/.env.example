# DeFi Analytics Frontend - Environment Configuration
# Copy this file to .env.local and fill in your values

# ====================================================================================
# API CONFIGURATION
# ====================================================================================

# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_TIMEOUT=30000

# WebSocket URL (for real-time updates)
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# ====================================================================================
# WEB3 CONFIGURATION
# ====================================================================================

# Ethereum RPC URL (for frontend Web3 interactions)
NEXT_PUBLIC_ETHEREUM_RPC_URL=https://mainnet.infura.io/v3/YOUR_PROJECT_ID

# Chain ID
NEXT_PUBLIC_CHAIN_ID=1

# WalletConnect Project ID (get from https://cloud.walletconnect.com/)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ====================================================================================
# APPLICATION SETTINGS
# ====================================================================================

# App Environment
NEXT_PUBLIC_ENVIRONMENT=development

# Enable Features
NEXT_PUBLIC_ENABLE_WALLET_CONNECT=true
NEXT_PUBLIC_ENABLE_LIVE_DATA=true
NEXT_PUBLIC_ENABLE_NOTIFICATIONS=true

# Data Refresh Intervals (milliseconds)
NEXT_PUBLIC_PORTFOLIO_REFRESH_INTERVAL=30000
NEXT_PUBLIC_PRICE_REFRESH_INTERVAL=10000
NEXT_PUBLIC_METRICS_REFRESH_INTERVAL=60000

# ====================================================================================
# ANALYTICS & MONITORING
# ====================================================================================

# Google Analytics (optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Mixpanel (optional)
NEXT_PUBLIC_MIXPANEL_TOKEN=

# Sentry Error Tracking
NEXT_PUBLIC_SENTRY_DSN=

# ====================================================================================
# UI SETTINGS
# ====================================================================================

# Theme
NEXT_PUBLIC_DEFAULT_THEME=dark  # light or dark

# Display Settings
NEXT_PUBLIC_DEFAULT_CURRENCY=USD
NEXT_PUBLIC_DEFAULT_LANGUAGE=en

# Chart Settings
NEXT_PUBLIC_CHART_ANIMATION=true
NEXT_PUBLIC_DEFAULT_CHART_DAYS=30

# ====================================================================================
# DEVELOPMENT
# ====================================================================================

# Debug Mode
NEXT_PUBLIC_DEBUG=false

# Mock Data (for development without backend)
NEXT_PUBLIC_USE_MOCK_DATA=false

# Show Developer Tools
NEXT_PUBLIC_SHOW_DEV_TOOLS=false

# ====================================================================================
# EXTERNAL SERVICES
# ====================================================================================

# CoinGecko API (for price charts)
NEXT_PUBLIC_COINGECKO_API_URL=https://api.coingecko.com/api/v3

# DefiLlama API (for TVL data)
NEXT_PUBLIC_DEFILLAMA_API_URL=https://api.llama.fi

# ====================================================================================
# SEO & META
# ====================================================================================

NEXT_PUBLIC_APP_NAME=DeFi Analytics Platform
NEXT_PUBLIC_APP_DESCRIPTION=Comprehensive DeFi portfolio management and analytics
NEXT_PUBLIC_APP_URL=http://localhost:3001

# ====================================================================================
# SECURITY
# ====================================================================================

# Content Security Policy
NEXT_PUBLIC_CSP_ENABLED=false

# Enable HTTPS only (for production)
NEXT_PUBLIC_FORCE_HTTPS=false
