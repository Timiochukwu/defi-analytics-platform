# DeFi Analytics Platform - Environment Configuration
# Copy this file to .env and fill in your values

# ====================================================================================
# WEB3 & BLOCKCHAIN CONFIGURATION
# ====================================================================================

# Ethereum RPC Provider (choose one or add multiple)
# Get free API keys from: https://infura.io/ or https://alchemy.com/
ETHEREUM_RPC_URL=https://mainnet.infura.io/v3/YOUR_PROJECT_ID
# ETHEREUM_RPC_URL=https://eth-mainnet.alchemyapi.io/v2/YOUR_API_KEY
# ETHEREUM_RPC_URL=http://localhost:8545  # For local node

# Alternative RPC endpoints (for failover)
ETHEREUM_RPC_FALLBACK_1=
ETHEREUM_RPC_FALLBACK_2=

# Chain ID (1 for Ethereum mainnet, 5 for Goerli testnet, etc.)
CHAIN_ID=1

# The Graph API endpoints
THE_GRAPH_API_KEY=
UNISWAP_GRAPH_URL=https://api.thegraph.com/subgraphs/name/uniswap/uniswap-v3
AAVE_GRAPH_URL=https://api.thegraph.com/subgraphs/name/aave/protocol-v3
CURVE_GRAPH_URL=https://api.thegraph.com/subgraphs/name/messari/curve-finance-ethereum

# ====================================================================================
# DATABASE CONFIGURATION
# ====================================================================================

# PostgreSQL Database
DATABASE_URL=postgresql://user:password@localhost:5432/defi_analytics
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis Cache
REDIS_URL=redis://localhost:6379/0
REDIS_TTL=3600  # Cache TTL in seconds

# ====================================================================================
# API CONFIGURATION
# ====================================================================================

# FastAPI Settings
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
API_WORKERS=4

# API Keys & Authentication
API_SECRET_KEY=your-secret-key-here-change-in-production
API_ACCESS_TOKEN_EXPIRE_MINUTES=30
API_ALGORITHM=HS256

# CORS Settings (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=100

# ====================================================================================
# EXTERNAL APIs (Optional)
# ====================================================================================

# CoinGecko API (for price data)
COINGECKO_API_KEY=
COINGECKO_API_URL=https://api.coingecko.com/api/v3

# Etherscan API (for contract verification)
ETHERSCAN_API_KEY=

# DefiLlama API (for TVL data)
DEFILLAMA_API_URL=https://api.llama.fi

# ====================================================================================
# LOGGING & MONITORING
# ====================================================================================

# Log Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
LOG_FORMAT=json  # or 'text'
LOG_FILE_PATH=logs/defi_analytics.log

# Sentry Error Tracking (optional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# ====================================================================================
# TASK SCHEDULING (Celery)
# ====================================================================================

# Celery Broker
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Task Settings
CELERY_TASK_TIME_LIMIT=300  # seconds
CELERY_TASK_SOFT_TIME_LIMIT=240  # seconds

# ====================================================================================
# APPLICATION SETTINGS
# ====================================================================================

# Environment
ENVIRONMENT=development  # development, staging, production

# Data Collection Settings
DATA_REFRESH_INTERVAL=300  # seconds
ENABLE_BACKGROUND_TASKS=true

# Risk Model Parameters
DEFAULT_RISK_TOLERANCE=3.0
MIN_PROTOCOL_AGE_DAYS=30
MIN_AUDIT_SCORE=70

# Portfolio Optimization
MAX_POSITION_SIZE=0.40  # 40% max allocation
MIN_LIQUIDITY_USD=1000000  # $1M minimum liquidity

# ====================================================================================
# DEVELOPMENT & TESTING
# ====================================================================================

# Debug Mode
DEBUG=true

# Testing
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/defi_analytics_test
PYTEST_WORKERS=4

# Mock Data (for testing without real blockchain calls)
USE_MOCK_DATA=false
MOCK_DATA_PATH=data/mock/

# ====================================================================================
# SECURITY
# ====================================================================================

# WARNING: Never commit real private keys or API keys to version control!
# Use environment variables or secure secret management systems

# Private key for contract interactions (if needed)
# PRIVATE_KEY=  # DO NOT COMMIT THIS!

# Encryption key for sensitive data
ENCRYPTION_KEY=

# HTTPS/SSL
USE_SSL=false
SSL_CERT_PATH=
SSL_KEY_PATH=
